# int — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Required ---

# Shared static secret for client->server auth.
# Any MCP client (OpenCode, int-cli) must send this in the API_KEY header.
API_KEY=

# Google Gemini API key used by the server to generate embeddings.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional (defaults shown) ---

# Gemini embedding model. Pin to gemini-embedding-001 for v1.
# Switching this after memories exist silently invalidates stored vectors
# (embedding spaces are incompatible across models).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Output embedding dimension. gemini-embedding-001 defaults to 3072;
# we truncate to 768 via MRL (minimal MTEB loss) and L2-normalize before Qdrant.
# Changing this after memories exist silently invalidates stored vectors.
GEMINI_EMBEDDING_DIMENSIONS=768

# Qdrant endpoint. Inside docker-compose the service is named `qdrant`.
QDRANT_URL=http://qdrant:6333

# Qdrant collection name.
QDRANT_COLLECTION=int_memories

# FastAPI bind.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Logging level. INFO logs metadata + content hashes only; never raw memory content.
LOG_LEVEL=INFO
